binds {
    // --- session -----------------------------------------------------------
    // openBinds renders a cheat sheet parsed from these very binds, which is
    // closer to awesome's hotkeys_popup than niri's own show-hotkey-overlay.
    Mod+S { spawn "dms" "ipc" "call" "keybinds" "openBinds"; }
    Mod+Ctrl+Q { quit; }

    // --- launchers ---------------------------------------------------------
    Mod+Return { spawn "kitty"; }
    Mod+R { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+W { toggle-overview; }
    Mod+X { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+F { spawn "firefox"; }
    Mod+G { spawn "firefox" "--private-window"; }
    Mod+B { spawn "brave-browser"; }
    Mod+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Space { spawn "rofi" "-show" "drun"; }

    // --- focus and movement ------------------------------------------------
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Ctrl+H { set-column-width "-5%"; }   // was incmwfact -0.05
    Mod+Ctrl+L { set-column-width "+5%"; }   // was incmwfact +0.05
    Mod+Ctrl+J { focus-monitor-next; }
    Mod+Ctrl+K { focus-monitor-previous; }
    Mod+Tab { focus-window-previous; }

    // No awesome ancestor: niri's core column management.
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // --- layout and window state -------------------------------------------
    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }
    Mod+Ctrl+M { expand-column-to-available-width; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Ctrl+Space { switch-preset-column-width; }
    Mod+Shift+C { close-window; }
    Mod+Ctrl+Return { move-column-to-first; }   // was swap with master
    Mod+O { move-window-to-monitor-next; }

    // --- workspaces --------------------------------------------------------
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }

    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+3 { move-window-to-workspace "3"; }
    Mod+Shift+4 { move-window-to-workspace "4"; }
    Mod+Shift+5 { move-window-to-workspace "5"; }

    Mod+P { focus-workspace-up; }     // awful.tag.viewprev
    Mod+N { focus-workspace-down; }   // awful.tag.viewnext

    // --- hardware ----------------------------------------------------------
    // DMS draws its own OSD, replacing utils/volume.lua's naughty.notify.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }

    // awesome marked these "-- FIXME: Doesn't work"; routing via DMS fixes them.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "10"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "10"; }

    Print { screenshot; }             // replaces flameshot gui
    Mod+I { spawn "fcitx5-remote" "-t"; }   // was utils.ibus.toggle
}
