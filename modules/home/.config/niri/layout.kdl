workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

layout {
    gaps 16

    // The wallpaper lives in the backdrop (see window-rules.kdl), so the
    // workspace itself must not paint over it.
    background-color "transparent"

    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        off
    }

    border {
        on
        width 5
        active-color "#eed49f"     // catppuccin macchiato yellow
        inactive-color "#494d64"
    }
}
