// Motion is split by kind, not by taste: springs for continuous, spatially
// tracked motion, easings for discrete enter/exit. A spring carries touchpad
// release velocity and retargets mid-flight when you interrupt it; a fixed
// duration curve restarts from zero every time.
animations {
    // Driven by the vertical touchpad gesture.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // niri drives these three from a single config wherever they overlap (a
    // resize that shifts the view animates both with window-resize), so they
    // have to stay identical.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Four-finger swipe up opens the overview.
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Decelerate in, accelerate out, exits shorter than entrances. 200ms on
    // open also keeps the unblurred-to-blurred pop short, since non-xray blur
    // is absent for the whole opening animation.
    window-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    window-close {
        duration-ms 150
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    recent-windows-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    slowdown 1.0
}
