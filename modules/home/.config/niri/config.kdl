// niri, ported from the AwesomeWM config in ../awesome.
// Design: docs/superpowers/specs/2026-08-28-niri-dms-awesome-port-design.md
//
// This repo owns the whole file, colors included. Do NOT enable
// matugenTemplateNiri in DankMaterialShell: it would rewrite this file, which
// is an out-of-store symlink into the git repo.

environment {
    DISPLAY ":0"
}

spawn-at-startup "xwayland-satellite"

input {
    touchpad {
        natural-scroll
    }
    mouse {
        natural-scroll
    }
}

prefer-no-csd

// Motion is split by kind, not by taste: springs for continuous, spatially
// tracked motion, easings for discrete enter/exit. A spring carries touchpad
// release velocity and retargets mid-flight when you interrupt it; a fixed
// duration curve restarts from zero every time.
animations {
    // Driven by the vertical touchpad gesture.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // niri drives these three from a single config wherever they overlap (a
    // resize that shifts the view animates both with window-resize), so they
    // have to stay identical.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Four-finger swipe up opens the overview.
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Decelerate in, accelerate out, exits shorter than entrances. 200ms on
    // open also keeps the unblurred-to-blurred pop short, since non-xray blur
    // is absent for the whole opening animation.
    window-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    window-close {
        duration-ms 150
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    recent-windows-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    slowdown 1.0
}

// Nine named workspaces standing in for awesome's nine static tags. Naming
// them makes them persistent, so Mod+N always lands on the same workspace
// whether or not it holds windows.
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"

layout {
    gaps 16

    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#a6da95"     // theme.border_focus, was #A8C98F
        inactive-color "#494d64"   // awesome hid these; keep them quiet instead
    }
}

// signals.lua rounded every client on manage; fullscreen squaring is automatic.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.975

    background-effect {
        blur true
        xray false
    }
}

// The only survivor of rules.lua's float list. The rest (Arandr, Wpa_gui,
// veromix, xtightvncviewer, Tor Browser, Kruler, Sxiv, MessageWin, Event
// Tester, Gpick) are X11-era and not installed; Blueman-manager and copyq are
// superseded by DankMaterialShell; the role matches (AlarmWindow,
// ConfigManager, pop-up) are an X11 concept niri can't match on Wayland.
window-rule {
    match app-id="pinentry"
    open-floating true
}

window-rule {
    match app-id=r#"^fcitx5-config"#
    open-floating true
}

binds {
    // --- session -----------------------------------------------------------
    // openBinds renders a cheat sheet parsed from these very binds, which is
    // closer to awesome's hotkeys_popup than niri's own show-hotkey-overlay.
    Mod+S { spawn "dms" "ipc" "call" "keybinds" "openBinds"; }
    Mod+Ctrl+Q { quit; }

    // --- launchers ---------------------------------------------------------
    Mod+Return { spawn "kitty"; }
    Mod+R { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+W { toggle-overview; }
    Mod+X { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+F { spawn "firefox"; }
    Mod+G { spawn "firefox" "--private-window"; }
    Mod+B { spawn "brave-browser"; }
    Mod+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }

    // --- focus and movement ------------------------------------------------
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Ctrl+H { set-column-width "-5%"; }   // was incmwfact -0.05
    Mod+Ctrl+L { set-column-width "+5%"; }   // was incmwfact +0.05
    Mod+Ctrl+J { focus-monitor-next; }
    Mod+Ctrl+K { focus-monitor-previous; }
    Mod+Tab { focus-window-previous; }

    // No awesome ancestor: niri's core column management.
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // --- layout and window state -------------------------------------------
    Mod+Space { switch-preset-column-width; }
    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }
    Mod+Ctrl+M { expand-column-to-available-width; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Shift+C { close-window; }
    Mod+Ctrl+Return { move-column-to-first; }   // was swap with master
    Mod+O { move-window-to-monitor-next; }

    // --- workspaces --------------------------------------------------------
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }

    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+3 { move-window-to-workspace "3"; }
    Mod+Shift+4 { move-window-to-workspace "4"; }
    Mod+Shift+5 { move-window-to-workspace "5"; }
    Mod+Shift+6 { move-window-to-workspace "6"; }
    Mod+Shift+7 { move-window-to-workspace "7"; }
    Mod+Shift+8 { move-window-to-workspace "8"; }
    Mod+Shift+9 { move-window-to-workspace "9"; }

    Mod+P { focus-workspace-up; }     // awful.tag.viewprev
    Mod+N { focus-workspace-down; }   // awful.tag.viewnext

    // --- hardware ----------------------------------------------------------
    // DMS draws its own OSD, replacing utils/volume.lua's naughty.notify.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }

    // awesome marked these "-- FIXME: Doesn't work"; routing via DMS fixes them.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "10"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "10"; }

    Print { screenshot; }             // replaces flameshot gui
    Mod+I { spawn "fcitx5-remote" "-t"; }   // was utils.ibus.toggle
}
