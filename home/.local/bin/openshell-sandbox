#!/usr/bin/env bash

set -e

dotfiles="$HOME/dotfiles"

policy="${OPENSHELL_SANDBOX_POLICY:-$HOME/.config/openshell/policy.yaml}"

image() {
  docker build -t openshell-sandbox:latest -f "$dotfiles/home/.config/openshell/sandbox/Dockerfile" "$dotfiles"
}

provider() {
  openshell provider get github >/dev/null 2>&1 ||
    GH_TOKEN=$(gh auth token) openshell provider create --name github --type github --credential GH_TOKEN
}

recreate() {
  local name="${1:-dev}"
  openshell sandbox delete "$name" || true
  openshell sandbox create --name "$name" --detach --provider github --policy "$policy"
}

usage() {
  echo "usage: openshell-sandbox [name] | image | provider | recreate [name]" >&2
}

case "${1:-}" in
image) image ;;
provider) provider ;;
recreate) recreate "${2:-}" ;;
-h | --help) usage ;;
-*)
  usage
  exit 2
  ;;
*)
  image
  provider
  recreate "${1:-}"
  ;;
esac
