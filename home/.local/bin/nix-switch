#!/usr/bin/env bash

set -e

cd ~/dotfiles

git submodule update --init --recursive

nix_flags=(--extra-experimental-features "nix-command flakes")

case "$(uname -s)" in
  Darwin)
    sudo nix run "${nix_flags[@]}" .#darwin-rebuild -- switch --flake .#mac --impure "$@"
    ;;
  Linux)
    if [ -f /etc/fedora-release ]; then
      host=fedora
    elif grep -qx 'ID=ubuntu' /etc/os-release; then
      host="ubuntu-$(uname -m)"
    else
      echo "Unsupported Linux distribution" >&2
      exit 1
    fi
    if [ "$#" -gt 0 ]; then
      echo "nix-switch: extra arguments are not supported on Linux" >&2
      echo "system-manager and home-manager take different flags; run them directly" >&2
      exit 2
    fi
    nix run "${nix_flags[@]}" .#system-manager -- switch --flake ".#$host" --sudo
    nix run "${nix_flags[@]}" .#home-manager -- switch --flake ".#$host" --impure
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac
