#!/usr/bin/env bash

set -e

self="${0##*/}"

dotfiles="$HOME/dotfiles"

policy="${OPENSHELL_SANDBOX_POLICY:-$HOME/.config/openshell/policy.yaml}"

creds_volume="osb-creds"

workdir=""

build() {
  local flags=()

  case "${1:-}" in
  "") ;;
  # The nix install layer is cached on its instruction text, so a moved
  # nixpkgs-unstable never invalidates it on its own.
  --update) flags=(--pull --no-cache-filter tools) ;;
  *)
    echo "$self: unknown build option: $1" >&2
    usage
    exit 2
    ;;
  esac

  docker build "${flags[@]}" -t openshell-sandbox:latest -f "$dotfiles/home/.config/openshell/sandbox/Dockerfile" "$dotfiles"
}

provider() {
  openshell provider get github >/dev/null 2>&1 ||
    GH_TOKEN=$(gh auth token) openshell provider create --name github --type github --credential GH_TOKEN
}

slug() {
  local s
  s=$(basename "$1" | tr '[:upper:]' '[:lower:]')
  s=${s//[^a-z0-9-]/-}
  while [[ $s == *--* ]]; do s=${s//--/-}; done
  s=${s#-}
  s=${s%-}
  printf '%s' "${s:-workspace}"
}

# Sets workdir to the absolute path of an existing directory.
resolve() {
  local dir="$1"

  if [ ! -d "$dir" ]; then
    echo "$self: not a directory: $dir" >&2
    exit 2
  fi

  # Physical path, so a symlink to the home cannot slip past the mount check.
  workdir=$(cd "$dir" && pwd -P)
}

# Validates the directory to mount and sets workdir to its absolute path.
resolve_mount() {
  local dir="${1:-}"

  if [ -z "$dir" ]; then
    echo "$self: a directory to mount is required (use . for the current one)" >&2
    usage
    exit 2
  fi

  resolve "$dir"
  local home
  home=$(cd "$HOME" && pwd -P)

  # Mounting the home, or anything above it, would hand the sandbox every credential in it.
  case "$home/" in
  "${workdir%/}/"*)
    echo "$self: refusing to mount $workdir" >&2
    exit 1
    ;;
  esac
}

recreate() {
  local target name mounts
  resolve_mount "${1:-}"

  target="/sandbox/$(slug "$workdir")"
  name="${2:-$(slug "$workdir")}"
  # The image symlinks the agents' OAuth files into .creds, so logins outlive
  # `sandbox delete`. /sandbox itself is reserved and cannot be a mount target.
  # Built before the delete so a jq failure aborts with the old sandbox intact.
  mounts=$(jq -nc --arg source "$workdir" --arg target "$target" --arg volume "$creds_volume" \
    '{docker: {mounts: [
      {type: "volume", source: $volume, target: "/sandbox/.creds", read_only: false},
      {type: "bind", source: $source, target: $target, read_only: false}
    ]}}')
  # The gateway rejects a volume it cannot find; creating an existing one is a no-op.
  docker volume create "$creds_volume" >/dev/null

  openshell sandbox delete "$name" || true
  openshell sandbox create --name "$name" --detach --provider github --policy "$policy" \
    --driver-config-json "$mounts"
  echo "mounted $workdir -> $target"
}

# Sets name to the sandbox for a directory, which defaults to the current one.
resolve_name() {
  resolve "${1:-.}"
  name="${2:-$(slug "$workdir")}"
}

start() {
  local name
  resolve_name "$@"

  openshell sandbox start "$name" && return

  # Recreating is destructive, so it is only suggested when nothing else can
  # help: the sandbox is gone or errored, not when the gateway is unreachable.
  local phase
  phase=$(openshell sandbox get "$name" -o json 2>&1 | jq -r '.phase' 2>/dev/null) || phase=""
  case "$phase" in
  Error) echo "$self: $name is errored; recreate it with: $self $workdir${2:+ $2}" >&2 ;;
  "") openshell sandbox list >/dev/null 2>&1 &&
    echo "$self: no sandbox named $name; create it with: $self $workdir${2:+ $2}" >&2 ;;
  esac
  exit 1
}

stop() {
  local name
  resolve_name "$@"

  openshell sandbox stop "$name"
}

connect() {
  local target name
  resolve_name "$@"

  target="/sandbox/$(slug "$workdir")"

  # A fresh process rather than `sandbox connect`, which attaches to the main
  # shell: exiting that one tears the sandbox down.
  exec openshell sandbox exec -n "$name" --workdir "$target" -- bash -l
}

usage() {
  cat >&2 <<EOF
usage: $self <dir> [name]            build, ensure provider, recreate (full setup)
       $self build [--update]        build the sandbox image (--update refreshes base images and nix packages)
       $self provider                create the github provider if missing
       $self recreate <dir> [name]   delete and recreate the sandbox
       $self start [dir] [name]      start a stopped sandbox (dir defaults to .)
       $self stop [dir] [name]       stop the sandbox, keeping its state
       $self connect [dir] [name]    open a shell in the sandbox (dir defaults to .)
<dir> is mounted at /sandbox/<basename>; name defaults to <basename>
agent logins persist across recreate in the docker volume osb-creds
EOF
}

case "${1:-}" in
build) build "${2:-}" ;;
provider) provider ;;
recreate) recreate "${2:-}" "${3:-}" ;;
start) start "${2:-}" "${3:-}" ;;
stop) stop "${2:-}" "${3:-}" ;;
connect) connect "${2:-}" "${3:-}" ;;
-h | --help) usage ;;
-* | "")
  usage
  exit 2
  ;;
*)
  resolve_mount "$1"
  build
  provider
  recreate "$workdir" "${2:-}"
  ;;
esac
