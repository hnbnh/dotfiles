#!/usr/bin/env bash

set -e

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
cd "$(cd -P "$(dirname "$src")/.." && pwd)"

nix_flags=(--extra-experimental-features "nix-command flakes")

case "$(uname -s)" in
  Darwin)
    if [ $# -gt 0 ]; then host="$1"; shift; else host="mac"; fi
    sudo nix run "${nix_flags[@]}" .#darwin-rebuild -- switch --flake ".#${host}" --impure "$@"
    ;;
  Linux)
    if [ ! -f /etc/fedora-release ]; then
      echo "Unsupported Linux distribution" >&2
      exit 1
    fi
    if [ $# -gt 0 ]; then host="$1"; shift; else host="fedora"; fi
    nix run "${nix_flags[@]}" .#system-manager -- switch --flake ".#${host}" --sudo "$@"
    nix run "${nix_flags[@]}" .#home-manager -- switch --flake ".#${host}" --impure "$@"
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac
