#!/usr/bin/env bash
# relink — link dotfiles into place, keeping tool state out of the repo.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
DOTFILES_DIR="$(cd "$DOTFILES_DIR" && pwd -P)"
HOME_DIR="$(cd "$HOME" && pwd -P)"
CFG_DIR="$DOTFILES_DIR/config"
CONF_FILE="$CFG_DIR/links.conf"

APPLY=0
QUIET=0
FORCE=0
CHANGES=0
DRIFT=0

usage() {
  echo "usage: relink [--apply] [--force] [-q]"
  echo "  no flags   show the plan, exit 1 if anything differs"
  echo "  --apply    execute the plan"
  echo "  --force    replace a regular file sitting at a planned link site"
  echo "  -q         suppress output"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --force) FORCE=1 ;;
    -q|--quiet) QUIET=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

say() {
  if [ "$QUIET" -eq 0 ]; then printf '%s\n' "$*"; fi
}

PLAN_SRC=()
PLAN_DEST=()

LINK_SRC=()
LINK_DEST=()

plan_add() {
  PLAN_SRC+=("$1")
  PLAN_DEST+=("$2")
}

# config/.foo -> ~/.foo ; config/foo -> ~/.config/foo
dest_root() {
  case "$1" in
    .*) printf '%s/%s' "$HOME_DIR" "$1" ;;
    *)  printf '%s/.config/%s' "$HOME_DIR" "$1" ;;
  esac
}

SHARED=()
SHARED_DEST=()

parse_conf() {
  local directive a b
  if [ ! -f "$CONF_FILE" ]; then return 0; fi
  while read -r directive a b || [ -n "$directive" ]; do
    case "$directive" in
      ''|\#*) continue ;;
      shared)
        if [ -z "$a" ]; then
          echo "relink: 'shared' needs a name in $CONF_FILE" >&2
          exit 2
        fi
        SHARED+=("$a")
        ;;
      link)
        if [ -z "$a" ] || [ -z "$b" ]; then
          echo "relink: 'link' needs a source and a destination in $CONF_FILE" >&2
          exit 2
        fi
        LINK_SRC+=("$a")
        LINK_DEST+=("${b/#\~/$HOME_DIR}")
        ;;
      *)
        echo "relink: unknown directive '$directive' in $CONF_FILE" >&2
        exit 2
        ;;
    esac
  done < "$CONF_FILE"
  return 0
}

is_shared() {
  local name="$1" s
  for s in ${SHARED[@]+"${SHARED[@]}"}; do
    if [ "$s" = "$name" ]; then return 0; fi
  done
  return 1
}

# Paths tracked under config/<name>/, relative to that directory.
tracked_rel() {
  local name="$1" f
  git -C "$DOTFILES_DIR" ls-files "config/$name" | while IFS= read -r f; do
    printf '%s\n' "${f#config/$name/}"
  done
}

needs_migration() {
  local dest="$1" target
  if [ ! -L "$dest" ]; then return 1; fi
  target="$(readlink "$dest")"
  target="${target%/}"
  case "$target" in
    "$DOTFILES_DIR"|"$DOTFILES_DIR"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Turn a destination that is a symlink into the repo into a real directory:
# move the whole directory out (a rename — instant, and open file handles
# follow their inodes), then copy the tracked files back into the repo.
migrate_shared() {
  local name="$1" dest="$2" repo="$CFG_DIR/$name" rel
  CHANGES=$((CHANGES + 1))
  say "  migrate  config/$name -> $dest"
  if [ "$APPLY" -eq 0 ]; then
    # Can't touch the filesystem to preview per-file link_one results: $dest
    # is still the pre-migration symlink, so every tracked file would appear
    # to already exist and get misreported as drift. Preview the links the
    # migration will create instead.
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      CHANGES=$((CHANGES + 1))
      say "  link     $dest/$rel -> $repo/$rel"
    done < <(tracked_rel "$name")
    return 0
  fi

  rm "$dest"
  mv "$repo" "$dest"
  mkdir -p "$repo"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ ! -e "$dest/$rel" ]; then
      printf '  warn     config/%s/%s is tracked but missing; skipped\n' "$name" "$rel" >&2
      continue
    fi
    # A gitlink (submodule) is a directory on disk; cp -p only handles
    # regular files. Leave it where the mv put it rather than aborting the
    # whole migration under set -e.
    if [ -d "$dest/$rel" ]; then
      printf '  warn     config/%s/%s is not a regular file; skipped\n' "$name" "$rel" >&2
      continue
    fi
    mkdir -p "$repo/$(dirname "$rel")"
    cp -p "$dest/$rel" "$repo/$rel"
    rm "$dest/$rel"
  done < <(tracked_rel "$name")
  return 0
}

build_plan() {
  local entry name dest rel
  for entry in "$CFG_DIR"/*/ "$CFG_DIR"/.*/; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    case "$name" in .|..) continue ;; esac
    dest="$(dest_root "$name")"
    if is_shared "$name"; then
      SHARED_DEST+=("$dest")
      if needs_migration "$dest"; then
        migrate_shared "$name" "$dest"
        if [ "$APPLY" -eq 0 ]; then continue; fi
      fi
      if [ -L "$dest" ]; then
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a symlink; a shared directory's root must be a real directory"
        continue
      fi
      if [ -e "$dest" ] && [ ! -d "$dest" ]; then
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a regular file; a shared directory's root must be a real directory"
        continue
      fi
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        plan_add "$CFG_DIR/$name/$rel" "$dest/$rel"
      done < <(tracked_rel "$name")
    else
      plan_add "${entry%/}" "$dest"
    fi
  done
  local i
  for ((i = 0; i < ${#LINK_SRC[@]}; i++)); do
    plan_add "$CFG_DIR/${LINK_SRC[$i]}" "${LINK_DEST[$i]}"
  done
  return 0
}

link_one() {
  local src="$1" dest="$2" cur cur_abs
  if [ -L "$dest" ]; then
    cur="$(readlink "$dest")"
    cur="${cur%/}"
    if [ "$cur" = "$src" ]; then return 0; fi
    # Resolve relative symlink targets against the directory of $dest
    if [[ "$cur" != /* ]]; then
      cur_abs="$(cd "$(dirname "$dest")" && pwd -P)/$cur"
      cur_abs="$(cd "$cur_abs" 2>/dev/null && pwd -P || echo "$cur_abs")"
    else
      cur_abs="$cur"
    fi
    cur_abs="${cur_abs%/}"
    # Check if symlink resolves inside DOTFILES_DIR (exact match or /boundary)
    case "$cur_abs" in
      "$DOTFILES_DIR"|"$DOTFILES_DIR"/*)
        # Inside repo but wrong target: silently fix it
        CHANGES=$((CHANGES + 1))
        say "  relink   $dest -> $src"
        if [ "$APPLY" -eq 1 ]; then
          rm -f "$dest"
          ln -sfn "$src" "$dest"
        fi
        return 0
        ;;
      *)
        # Outside repo: treat as drift
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a symlink to $cur (expected -> $src)"
        if [ "$FORCE" -eq 1 ]; then
          DRIFT=$((DRIFT - 1))
          CHANGES=$((CHANGES + 1))
          say "  force    replacing $dest"
          if [ "$APPLY" -eq 1 ]; then
            rm -f "$dest"
            ln -sfn "$src" "$dest"
          fi
        fi
        return 0
        ;;
    esac
  fi
  if [ -e "$dest" ]; then
    DRIFT=$((DRIFT + 1))
    say "  drift    $dest is not a symlink (expected -> $src)"
    if [ "$FORCE" -eq 1 ]; then
      DRIFT=$((DRIFT - 1))
      CHANGES=$((CHANGES + 1))
      say "  force    replacing $dest"
      if [ "$APPLY" -eq 1 ]; then
        rm -rf "$dest"
        ln -sfn "$src" "$dest"
      fi
    fi
    return 0
  fi
  CHANGES=$((CHANGES + 1))
  say "  link     $dest -> $src"
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$src" "$dest"
  fi
  return 0
}

main() {
  parse_conf
  build_plan

  local i
  for ((i = 0; i < ${#PLAN_DEST[@]}; i++)); do
    link_one "${PLAN_SRC[$i]}" "${PLAN_DEST[$i]}"
  done

  if [ "$APPLY" -eq 1 ]; then
    say "$CHANGES applied, $DRIFT drift"
    if [ "$DRIFT" -gt 0 ]; then exit 1; fi
    exit 0
  fi

  say "$CHANGES changes, $DRIFT drift"
  if [ "$CHANGES" -gt 0 ] || [ "$DRIFT" -gt 0 ]; then exit 1; fi
  exit 0
}

main
