#!/usr/bin/env bash
# relink — link dotfiles into place, keeping tool state out of the repo.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
DOTFILES_DIR="$(cd "$DOTFILES_DIR" && pwd -P)"
HOME_DIR="$(cd "$HOME" && pwd -P)"

CFG_DIR="$DOTFILES_DIR/config"
CONF_FILE="$CFG_DIR/links.conf"

APPLY=0
QUIET=0
FORCE=0
CHANGES=0
DRIFT=0

usage() {
  echo "usage: relink [--apply] [--force] [-q]"
  echo "  no flags   show the plan, exit 1 if anything differs"
  echo "  --apply    execute the plan"
  echo "  --force    replace a regular file sitting at a planned link site"
  echo "  -q         suppress output"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --force) FORCE=1 ;;
    -q|--quiet) QUIET=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

# tracked_rel relies on git ls-files; if it fails silently (see tracked_rel),
# a migration would report success while leaving the repo directory empty.
# Fail fast instead of discovering that partway through a migration. Below
# the argument loop so --help works even outside a git checkout.
git -C "$DOTFILES_DIR" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "relink: $DOTFILES_DIR is not a git repository" >&2; exit 2; }

say() {
  if [ "$QUIET" -eq 0 ]; then printf '%s\n' "$*"; fi
}

PLAN_SRC=()
PLAN_DEST=()

LINK_SRC=()
LINK_DEST=()

plan_add() {
  PLAN_SRC+=("$1")
  PLAN_DEST+=("$2")
}

# config/.foo -> ~/.foo ; config/foo -> ~/.config/foo
dest_root() {
  case "$1" in
    .*) printf '%s/%s' "$HOME_DIR" "$1" ;;
    *)  printf '%s/.config/%s' "$HOME_DIR" "$1" ;;
  esac
}

SHARED=()
SHARED_DEST=()

parse_conf() {
  local directive a b
  if [ ! -f "$CONF_FILE" ]; then return 0; fi
  while read -r directive a b || [ -n "$directive" ]; do
    case "$directive" in
      ''|\#*) continue ;;
      shared)
        if [ -z "$a" ]; then
          echo "relink: 'shared' needs a name in $CONF_FILE" >&2
          exit 2
        fi
        SHARED+=("$a")
        ;;
      link)
        if [ -z "$a" ] || [ -z "$b" ]; then
          echo "relink: 'link' needs a source and a destination in $CONF_FILE" >&2
          exit 2
        fi
        LINK_SRC+=("$a")
        LINK_DEST+=("${b/#\~/$HOME_DIR}")
        ;;
      *)
        echo "relink: unknown directive '$directive' in $CONF_FILE" >&2
        exit 2
        ;;
    esac
  done < "$CONF_FILE"

  # A shared name with no matching config/ directory silently reverts that
  # directory to whole-directory-link treatment (build_plan's plain branch)
  # instead of per-file links — the exact setup that turns a real,
  # state-holding directory into reported drift. Warn, don't exit 2: a
  # shared directory that doesn't exist yet on a fresh machine is fine.
  local s
  for s in ${SHARED[@]+"${SHARED[@]}"}; do
    if [ ! -d "$CFG_DIR/$s" ]; then
      printf '  warn     shared %s has no matching directory under config/; ignoring\n' "$s" >&2
    fi
  done
  return 0
}

is_shared() {
  local name="$1" s
  for s in ${SHARED[@]+"${SHARED[@]}"}; do
    if [ "$s" = "$name" ]; then return 0; fi
  done
  return 1
}

# Paths tracked under config/<name>/, relative to that directory.
tracked_rel() {
  local name="$1" f
  git -C "$DOTFILES_DIR" ls-files "config/$name" | while IFS= read -r f; do
    printf '%s\n' "${f#config/$name/}"
  done
}

needs_migration() {
  local dest="$1" target
  if [ ! -L "$dest" ]; then return 1; fi
  target="$(readlink "$dest")"
  target="${target%/}"
  case "$target" in
    "$DOTFILES_DIR"|"$DOTFILES_DIR"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Turn a destination that is a symlink into the repo into a real directory:
# move the whole directory out (a rename — instant, and open file handles
# follow their inodes), then copy the tracked files back into the repo.
migrate_shared() {
  local name="$1" dest="$2" repo="$CFG_DIR/$name" rel rels
  # Capture the tracked list BEFORE any destructive filesystem change, and
  # refuse on error or on empty output. tracked_rel's pipeline can fail
  # outright, but the realistic trigger is a truncated .git/index, where
  # `git ls-files` exits 0 with empty output instead of erroring — an error
  # check alone would miss that. Either way, discovering the problem after
  # `rm "$dest"; mv "$repo" "$dest"` would leave config/$name empty and the
  # run reporting success, so check before touching anything.
  rels="$(tracked_rel "$name")" || {
    echo "relink: failed to list git-tracked files under config/$name; refusing to migrate" >&2
    exit 2
  }
  if [ -z "$rels" ]; then
    echo "relink: no git-tracked files under config/$name; refusing to migrate" >&2
    exit 2
  fi

  CHANGES=$((CHANGES + 1))
  say "  migrate  config/$name -> $dest"
  if [ "$APPLY" -eq 0 ]; then
    # Can't touch the filesystem to preview per-file link_one results: $dest
    # is still the pre-migration symlink, so every tracked file would appear
    # to already exist and get misreported as drift. Preview the links the
    # migration will create instead.
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      CHANGES=$((CHANGES + 1))
      say "  link     $dest/$rel -> $repo/$rel"
    done <<< "$rels"
    return 0
  fi

  rm "$dest"
  mv "$repo" "$dest"
  mkdir -p "$repo"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ ! -e "$dest/$rel" ]; then
      printf '  warn     config/%s/%s is tracked but missing; skipped\n' "$name" "$rel" >&2
      continue
    fi
    # A gitlink (submodule) is a directory on disk; cp -p only handles
    # regular files. Leave it where the mv put it rather than aborting the
    # whole migration under set -e.
    if [ -d "$dest/$rel" ]; then
      printf '  warn     config/%s/%s is not a regular file; skipped\n' "$name" "$rel" >&2
      continue
    fi
    mkdir -p "$repo/$(dirname "$rel")"
    cp -p "$dest/$rel" "$repo/$rel"
    rm "$dest/$rel"
  done <<< "$rels"
  return 0
}

build_plan() {
  local entry name dest rel
  for entry in "$CFG_DIR"/*/ "$CFG_DIR"/.*/; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    case "$name" in .|..) continue ;; esac
    dest="$(dest_root "$name")"
    if is_shared "$name"; then
      SHARED_DEST+=("$dest")
      if needs_migration "$dest"; then
        migrate_shared "$name" "$dest"
        if [ "$APPLY" -eq 0 ]; then continue; fi
      fi
      if [ -L "$dest" ]; then
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a symlink; a shared directory's root must be a real directory"
        continue
      fi
      if [ -e "$dest" ] && [ ! -d "$dest" ]; then
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a regular file; a shared directory's root must be a real directory"
        continue
      fi
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        plan_add "$CFG_DIR/$name/$rel" "$dest/$rel"
      done < <(tracked_rel "$name")
    else
      plan_add "${entry%/}" "$dest"
    fi
  done
  local i
  for ((i = 0; i < ${#LINK_SRC[@]}; i++)); do
    plan_add "$CFG_DIR/${LINK_SRC[$i]}" "${LINK_DEST[$i]}"
  done
  return 0
}

link_one() {
  local src="$1" dest="$2" cur cur_abs target dir_part base_part
  if [ -L "$dest" ]; then
    cur="$(readlink "$dest")"
    cur="${cur%/}"
    if [ "$cur" = "$src" ]; then return 0; fi
    # Resolve the target the same way prune_scan does: canonicalize the
    # containing directory via cd/pwd -P so a lexical ".." component can't
    # masquerade as a path inside the repo. This applies uniformly to
    # relative and absolute targets, and to targets that are files or
    # directories — the basename itself needs no resolution since it can't
    # contain "..". Resolve into $target rather than $cur so the drift
    # message below still shows the symlink's actual, unmodified content.
    target="$cur"
    case "$target" in
      /*) ;;
      *) target="$(dirname "$dest")/$target" ;;
    esac
    dir_part="$(dirname "$target")"
    base_part="$(basename "$target")"
    dir_part="$(cd "$dir_part" 2>/dev/null && pwd -P || printf '%s' "$dir_part")"
    cur_abs="$dir_part/$base_part"
    cur_abs="${cur_abs%/}"
    # Check if symlink resolves inside DOTFILES_DIR (exact match or /boundary).
    # Exact match included deliberately (prune_scan below is prefix-only):
    # here $dest is a single planned link site, never $HOME itself, so
    # matching the repo root exactly cannot catch a convenience symlink like
    # ~/dotfiles -> $DOTFILES_DIR the way it would in prune_scan's $HOME walk.
    case "$cur_abs" in
      "$DOTFILES_DIR"|"$DOTFILES_DIR"/*)
        # Inside repo but wrong target: silently fix it
        CHANGES=$((CHANGES + 1))
        say "  relink   $dest -> $src"
        if [ "$APPLY" -eq 1 ]; then
          rm -f "$dest"
          ln -sfn "$src" "$dest"
        fi
        return 0
        ;;
      *)
        # Outside repo: treat as drift
        DRIFT=$((DRIFT + 1))
        say "  drift    $dest is a symlink to $cur (expected -> $src)"
        # Require the source to exist before forcing, same as the regular-file
        # branch below: forcing without it would link $dest to nothing.
        if [ "$FORCE" -eq 1 ] && [ -e "$src" ]; then
          DRIFT=$((DRIFT - 1))
          CHANGES=$((CHANGES + 1))
          say "  force    replacing $dest"
          if [ "$APPLY" -eq 1 ]; then
            rm -f "$dest"
            ln -sfn "$src" "$dest"
          fi
        fi
        return 0
        ;;
    esac
  fi
  if [ -e "$dest" ]; then
    DRIFT=$((DRIFT + 1))
    if [ -d "$dest" ]; then
      # A real directory here is exactly what a shared dest looks like once
      # migrated (or what any plain dest looks like pre-migration): it may
      # hold state nothing else has a copy of. --force replaces regular
      # files, never directories — there is no recovery from rm -rf here.
      say "  drift    $dest is a real directory (expected -> $src); refusing to replace; move it aside and re-run"
      return 0
    fi
    say "  drift    $dest is not a symlink (expected -> $src)"
    # Require the source to exist before forcing: if a migration was
    # interrupted between its mv and its copy-back loop, $src can be empty
    # while $dest still holds the real, possibly-uncommitted file content.
    # Forcing in that state would delete the only copy and link to nothing.
    if [ "$FORCE" -eq 1 ] && [ -e "$src" ]; then
      DRIFT=$((DRIFT - 1))
      CHANGES=$((CHANGES + 1))
      say "  force    replacing $dest"
      if [ "$APPLY" -eq 1 ]; then
        rm -f "$dest"
        ln -sfn "$src" "$dest"
      fi
    fi
    return 0
  fi
  CHANGES=$((CHANGES + 1))
  say "  link     $dest -> $src"
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$src" "$dest"
  fi
  return 0
}

in_plan() {
  local path="$1" d
  for d in ${PLAN_DEST[@]+"${PLAN_DEST[@]}"}; do
    if [ "$d" = "$path" ]; then return 0; fi
  done
  return 1
}

# True if $1 is itself a shared directory's destination root. A root that is
# still a repo symlink (pre-migration) is handled by build_plan/migrate_shared
# via the "migrate" line, not by prune — without this, the $HOME depth-1 scan
# would report it a second time as a stale link.
in_shared_dest() {
  local path="$1" d
  for d in ${SHARED_DEST[@]+"${SHARED_DEST[@]}"}; do
    if [ "$d" = "$path" ]; then return 0; fi
  done
  return 1
}

prune_scan() {
  local dir="$1" depth="$2" link target dir_part base_part
  # A symlinked root (pre-migration shared dir, or drift) is never descended
  # into: it is reported once, elsewhere, by build_plan/migrate_shared or
  # link_one, and find's non-descent through a symlinked start path holds
  # only by coincidence of dest_root never producing a trailing slash — make
  # it structural instead of relying on that.
  if [ -L "$dir" ]; then return 0; fi
  if [ ! -d "$dir" ]; then return 0; fi
  while IFS= read -r link; do
    if in_shared_dest "$link"; then continue; fi
    target="$(readlink "$link")" || continue
    target="${target%/}"
    case "$target" in
      /*) ;;
      *) target="$(dirname "$link")/$target" ;;
    esac
    # Canonicalize the containing directory (same cd/pwd -P approach as
    # link_one) so a lexical ".." component can't masquerade as a path
    # inside the repo; the basename needs no resolution since it can't
    # itself contain "..".
    dir_part="$(dirname "$target")"
    base_part="$(basename "$target")"
    dir_part="$(cd "$dir_part" 2>/dev/null && pwd -P || printf '%s' "$dir_part")"
    target="$dir_part/$base_part"
    # Prefix-only, deliberately unlike link_one's exact-match-or-prefix: this
    # scan walks $HOME and ~/.config, so an exact match to $DOTFILES_DIR would
    # be a convenience symlink such as ~/dotfiles -> $DOTFILES_DIR, which must
    # survive pruning, not be treated as a stale link into the repo.
    case "$target" in
      "$DOTFILES_DIR"/*) ;;
      *) continue ;;
    esac
    if in_plan "$link"; then continue; fi
    CHANGES=$((CHANGES + 1))
    say "  prune    $link"
    if [ "$APPLY" -eq 1 ]; then rm -f "$link"; fi
  done < <(find "$dir" -maxdepth "$depth" -type l 2>/dev/null)
  return 0
}

# Only symlinks resolving inside the repo are ever removed. Regular files,
# real directories, and links pointing elsewhere are invisible here.
prune() {
  local d
  for d in ${SHARED_DEST[@]+"${SHARED_DEST[@]}"}; do
    prune_scan "$d" 99
  done
  prune_scan "$HOME_DIR" 1
  prune_scan "$HOME_DIR/.config" 1
  return 0
}

main() {
  parse_conf
  build_plan

  local i
  for ((i = 0; i < ${#PLAN_DEST[@]}; i++)); do
    link_one "${PLAN_SRC[$i]}" "${PLAN_DEST[$i]}"
  done

  prune

  if [ "$APPLY" -eq 1 ]; then
    say "$CHANGES applied, $DRIFT drift"
    if [ "$DRIFT" -gt 0 ]; then exit 1; fi
    exit 0
  fi

  say "$CHANGES changes, $DRIFT drift"
  if [ "$CHANGES" -gt 0 ] || [ "$DRIFT" -gt 0 ]; then exit 1; fi
  exit 0
}

main
